# Written by scripts/install.sh; this copy documents the format.
# Install to /etc/queenscoach.env, root-owned, mode 0600:
#   sudo install -m 600 -o root -g root deploy/queenscoach.env.example /etc/queenscoach.env
#
# systemd parses this itself: no `export`, no quotes, no shell expansion.

# The public HTTPS URL the Cloudflare tunnel serves. This is the OAuth issuer,
# so it must be exactly what the Claude app dials, and it must stay stable.
CATS_PUBLIC_URL=https://cats.awanninger.com

# From the OAuth 2.0 "Web application" client in Google Cloud. Its authorized
# redirect URI must be <CATS_PUBLIC_URL>/auth/google/callback
CATS_GOOGLE_CLIENT_ID=
CATS_GOOGLE_CLIENT_SECRET=

# Who may use the server. Without one of these the server refuses to start.
CATS_ALLOWED_EMAILS=you@gmail.com

# Loopback only. Cloudflare terminates TLS and the tunnel connects here, so
# nothing needs to reach this port from outside the machine.
CATS_HTTP_HOST=127.0.0.1
CATS_HTTP_PORT=8000
