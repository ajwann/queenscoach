# Installed to /etc/systemd/system/ by scripts/install.sh.
# The server listens on loopback; the Cloudflare tunnel is the only way in.

[Unit]
Description=CATS transit MCP server
Documentation=https://github.com/ajwann/queenscoach
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=catsmcp
Group=catsmcp
WorkingDirectory=/opt/queenscoach

# Holds the Google client secret; root-owned, mode 0600.
EnvironmentFile=/etc/queenscoach.env
ExecStart=/opt/queenscoach/.venv/bin/queenscoach --transport http

Restart=on-failure
RestartSec=5s

# Binding loopback above 1024 needs no capability whatsoever.
CapabilityBoundingSet=

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX is needed for name resolution through nsswitch.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
