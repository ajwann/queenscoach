{
  "name": "queenscoach",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for Charlotte Area Transit System (CATS) realtime bus and light rail data",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "queenscoach": "./dist/index.js",
    "queenscoach-http": "./dist/http-server.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/http-server.js",
    "test": "node --test test/*.test.ts",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/http-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}